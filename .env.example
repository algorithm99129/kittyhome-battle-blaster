# Port this Paw Blaster server listens on
PORT=5201
# Where browsers reach it (the gateway and the arena page get it from core, through the database)
PUBLIC_URL=http://localhost:5201
# The community's address (comma-separated): only its pages can connect
CLIENT_ORIGINS=http://localhost:5187

# The same database as core: members, sessions, passes, coins and battle kits are shared
MONGODB_URI=mongodb://127.0.0.1:27017/kittyhome
MONGODB_DB=kittyhome

# The same Happy Hour as core (coins won are doubled then), UTC hours
HAPPY_HOUR_UTC=18

# Rooms of Paw Blaster this server runs at most (a new one opens when the others are full)
MAX_ROOMS=20
# Testing only: every round this many seconds
# ARENA_ROUND_SECONDS=40
